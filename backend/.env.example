# ===== 应用 =====
APP_ENV=development   # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ===== 安全 =====
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60*24*7   # 7天
JWT_REFRESH_TOKEN_TTL_MINUTES=60*24*30  # 30天

# ===== 数据库 =====
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# SaaS: postgresql+asyncpg://user:pass@host:5432/dbname

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:7860

# ===== 存储 =====
STORAGE_BACKEND=local        # local | s3 | r2
STORAGE_LOCAL_ROOT=./data/storage
# SaaS:
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# ===== Provider 默认值(用户可覆盖)=====
DEFAULT_LLM_PROVIDER=toapis
DEFAULT_LLM_MODEL=deepseek-v4-flash
DEFAULT_IMAGE_PROVIDER=toapis
DEFAULT_IMAGE_MODEL=gpt-image-2
DEFAULT_VIDEO_PROVIDER=toapis
DEFAULT_VIDEO_MODEL=seedance-2-mini
DEFAULT_TTS_PROVIDER=edge

# ===== 商业模式 =====
ENABLE_CREDIT_MODE=true       # 是否启用积分扣费(预留)
DEFAULT_FREE_CREDITS=100       # 新用户送 100 积分(预留)

# ===== 速率限制 =====
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=120

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FORMAT=json   # json | text

# ===== 任务队列(SaaS)=====
REDIS_URL=redis://localhost:6379/0
# SaaS: rediss://...

# ===== 第三方 API(可选,作为平台 fallback)=====
# 平台积分模式下,平台代理调 API,用这里配置的 key
PLATFORM_TOAPIS_API_KEY=
PLATFORM_TOAPIS_BASE_URL=https://toapis.com/v1
PLATFORM_YIJIA_API_KEY=
PLATFORM_YIJIA_BASE_URL=https://ai.yijiarj.cn/v1